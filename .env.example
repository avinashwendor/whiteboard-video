# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix any of these with NEXT_PUBLIC_.
# Copy to .env.local and fill in. .env* is already gitignored.
# ---------------------------------------------------------------------------

# Omega C -- text generation and storyboard planning. Required.
# Key format: oc_...   Dashboard: https://omegaplusapi.com
OMEGA_API_KEY=
# Optional override if the API host ever moves.
# OMEGA_BASE_URL=https://api.omegaplusapi.com

# Cartesia -- voice narration. Required for VOICE and for narrated videos.
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Optional pins. Defaults: sonic-3 on API version 2026-08-14.
# CARTESIA_MODEL=sonic-3
# CARTESIA_VERSION=2026-08-14

# Pollinations -- image generation fallback.
# OPTIONAL: images work with no key at all on the free tier. Adding a key
# switches to the OpenAI-compatible route and unlocks the premium catalogue.
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
