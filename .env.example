# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix any of these with NEXT_PUBLIC_.
# Copy to .env.local and fill in. .env* is already gitignored.
# ---------------------------------------------------------------------------

# Omega C -- text generation, storyboard planning, and the transcript editor's
# AI sidebar. Required.
# Key format: oc_...   Dashboard: https://omegaplusapi.com
OMEGA_API_KEY=
# Optional override if the API host ever moves.
# OMEGA_BASE_URL=https://api.omegaplusapi.com

# Deepgram -- voice narration. Leads over Cartesia when both are set: its word
# timings come from transcribing the actual audio, not an estimate.
# https://console.deepgram.com
DEEPGRAM_API_KEY=
# Optional pins. Defaults: aura-2-hera-en for speech, nova-3 to time it.
# DEEPGRAM_MODEL=aura-2-hera-en
# DEEPGRAM_ALIGN_MODEL=nova-3

# Cartesia -- voice narration, used when Deepgram isn't configured.
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Optional pins. Defaults: sonic-3 on API version 2026-08-14.
# CARTESIA_MODEL=sonic-3
# CARTESIA_VERSION=2026-08-14

# Tavily -- real-photo search, used for Modern Video's supporting visuals and
# the transcript editor's b-roll. Without it, a photo request fails cleanly and
# the AI planner is told not to plan one.
# https://tavily.com
TAVILY_API_KEY=

# Pollinations -- image generation fallback.
# OPTIONAL: images work with no key at all on the free tier. Adding a key
# switches to the OpenAI-compatible route and unlocks the premium catalogue.
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# ---------------------------------------------------------------------------
# Public, client-side config for the transcript editor (/motionscript). All
# optional -- each one is inert unless set.
# ---------------------------------------------------------------------------

# Absolute origin the editor's Open Graph tags resolve against.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# Anonymous usage telemetry. Unset means it never fires.
# NEXT_PUBLIC_TELEMETRY_ENDPOINT=

# Crash reporting (Sentry). Unset means it never initialises.
# NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Accounts (Clerk) — optional.
#
# The studio runs with no account: everything is generated in the browser and
# nothing is uploaded. Leave these unset and auth stays inert — the proxy
# passes requests straight through and the nav offers the waitlist instead.
#
# Keys come from dashboard.clerk.com. On Railway, set them as service
# variables rather than committing them.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk's keyless mode scaffolds its own sign-in pages into app/ when it
# finds no keys in development. Ours already exist, guarded and inside the
# route group, and the generated pair shadowed them with unguarded copies
# that rendered without a provider. Off.
CLERK_KEYLESS_DISABLED=1
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
