# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# icon cache
.icon-cache.json

# runtime assets copied from node_modules on postinstall
/public/vendor/

# Locally exported ONNX speech models (hundreds of MB of weights). Built by
# tools/export-telugu-onnx, served from /models/<id>/ for MODELS entries
# flagged `local`. Rebuild rather than commit.
/public/models/

# ad-hoc scratch media dropped at the repo root during manual testing
/scratch_*
/*.scratch.*
